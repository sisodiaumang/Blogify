<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head')%>
    <title>Story Archive & All Articles | Blogify</title>
    <meta name="description" content="Browse the complete directory and archive of stories, investigative reports, technology analysis, and essays published on Blogify.">
    <link rel="canonical" href="https://blogify-for-stories.vercel.app/archive">
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #fcfaf7;
            --ink: #1a1a1a;
            --accent: #2d3e50;
            --border: #eceae5;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
            color: var(--ink);
            margin: 0;
            line-height: 1.6;
        }

        .container {
            max-width: 1000px;
            margin: 40px auto 80px;
            padding: 0 24px;
        }

        .archive-header {
            margin-bottom: 40px;
            border-bottom: 2px solid var(--border);
            padding-bottom: 20px;
        }

        .archive-title {
            font-family: 'DM Serif Display', serif;
            font-size: 2.5rem;
            color: var(--accent);
            margin: 0 0 10px 0;
        }

        .category-group {
            margin-bottom: 40px;
        }

        .category-heading {
            font-family: 'DM Serif Display', serif;
            font-size: 1.5rem;
            color: var(--accent);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .archive-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .archive-item {
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .archive-link {
            color: var(--ink);
            text-decoration: none;
            font-weight: 500;
            font-size: 1.05rem;
            transition: color 0.2s;
            flex: 1;
            min-width: 250px;
        }

        .archive-link:hover {
            color: #0d6efd;
            text-decoration: underline;
        }

        .archive-date {
            font-size: 0.85rem;
            color: #777;
            white-space: nowrap;
        }
    </style>
</head>

<body>
    <%- include('./partials/nav')%>

    <main class="container">
        <header class="archive-header">
            <h1 class="archive-title">Story Directory &amp; Archive</h1>
            <p style="color: #666; margin: 0; font-size: 1rem;">
                Explore all <%= blogs.length %> published articles and breaking news coverage on Blogify.
            </p>
        </header>

        <section>
            <ul class="archive-list">
                <% blogs.forEach(blog => { %>
                    <li class="archive-item">
                        <a href="/blog/<%= blog._id %>" class="archive-link">
                            <%= blog.title %>
                        </a>
                        <span class="archive-date">
                            <%= new Date(blog.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                        </span>
                    </li>
                <% }) %>
            </ul>
        </section>
    </main>

    <%- include('./partials/script')%>
</body>
</html>
