<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head')%>
    <title><%= blog.title %> | Blogify</title>
    
    <!-- Primary SEO Metadata -->
    <meta name="description" content="<%= locals.seoExcerpt || 'Read the full article and discussion on Blogify.' %>">
    <meta name="keywords" content="<%= (blog.tags && blog.tags.length > 0) ? blog.tags.join(', ') : (blog.category || 'News, Analysis, Opinion, Editorial') %>">
    <meta name="author" content="<%= blog.createdBy?.fullName || 'Blogify Editorial' %>">
    <link rel="canonical" href="<%= locals.canonicalUrl || ('https://blogify-for-stories.vercel.app/blog/' + blog._id) %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="Blogify">
    <meta property="og:title" content="<%= blog.title %>">
    <meta property="og:description" content="<%= locals.seoExcerpt || 'Read the full article and discussion on Blogify.' %>">
    <meta property="og:url" content="<%= locals.canonicalUrl || ('https://blogify-for-stories.vercel.app/blog/' + blog._id) %>">
    <% if (blog.coverImageURL) { %>
    <meta property="og:image" content="<%= blog.coverImageURL %>">
    <meta property="og:image:secure_url" content="<%= blog.coverImageURL %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:alt" content="<%= blog.title %>">
    <% } %>
    <meta property="article:published_time" content="<%= new Date(blog.createdAt).toISOString() %>">
    <meta property="article:modified_time" content="<%= new Date(blog.updatedAt || blog.createdAt).toISOString() %>">
    <meta property="article:section" content="<%= blog.category || 'Editorial' %>">
    <% if (blog.tags && blog.tags.length > 0) { %>
        <% blog.tags.forEach(tag => { %>
    <meta property="article:tag" content="<%= tag %>">
        <% }) %>
    <% } %>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= blog.title %>">
    <meta name="twitter:description" content="<%= locals.seoExcerpt || 'Read the full article and discussion on Blogify.' %>">
    <% if (blog.coverImageURL) { %>
    <meta name="twitter:image" content="<%= blog.coverImageURL %>">
    <% } %>

    <!-- Google NewsArticle & BlogPosting Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "<%= locals.canonicalUrl || ('https://blogify-for-stories.vercel.app/blog/' + blog._id) %>"
      },
      "isPartOf": {
        "@type": "WebSite",
        "name": "Blogify",
        "alternateName": ["Blogify Stories", "Blogify Platform"],
        "url": "https://blogify-for-stories.vercel.app/"
      },
      "headline": <%- JSON.stringify(blog.title) %>,
      "description": <%- JSON.stringify(locals.seoExcerpt || 'Read the full article and discussion on Blogify.') %>,
      "image": [
        "<%= blog.coverImageURL || 'https://blogify-for-stories.vercel.app/apple-touch-icon.png' %>"
      ],
      "datePublished": "<%= new Date(blog.createdAt).toISOString() %>",
      "dateModified": "<%= new Date(blog.updatedAt || blog.createdAt).toISOString() %>",
      "wordCount": <%= blog.wordCount || 800 %>,
      "timeRequired": "PT<%= blog.readTimeMinutes || 3 %>M",
      "inLanguage": "en",
      "isAccessibleForFree": "True",
      "author": {
        "@type": "Person",
        "name": "<%= blog.createdBy?.fullName || 'Blogify Editorial Desk' %>",
        "url": "https://blogify-for-stories.vercel.app/user/<%= blog.createdBy?._id %>"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Blogify",
        "url": "https://blogify-for-stories.vercel.app",
        "logo": {
          "@type": "ImageObject",
          "url": "https://blogify-for-stories.vercel.app/favicon-32x32.png",
          "width": 32,
          "height": 32
        }
      },
      "articleSection": "<%= blog.category || 'Editorial' %>"
    }
    </script>

    <!-- Google BreadcrumbList Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://blogify-for-stories.vercel.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "<%= blog.category || 'Editorial' %>",
          "item": "https://blogify-for-stories.vercel.app/?category=<%= encodeURIComponent(blog.category || 'Editorial') %>"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": <%- JSON.stringify(blog.title) %>,
          "item": "<%= locals.canonicalUrl || ('https://blogify-for-stories.vercel.app/blog/' + blog._id) %>"
        }
      ]
    }
    </script>
    <style>
        :root {
            --radius: 16px;
            --nav-height: 75px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--ink);
            margin: 0;
            line-height: 1.75;
        }

        /* Reading Progress Bar */
        #reading-progress-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            z-index: 9999;
            background: transparent;
        }

        #reading-progress-bar {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #38bdf8, #2d3e50);
            transition: width 0.08s ease-out;
        }

        .page-grid {
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 50px;
            max-width: 1200px;
            margin: 30px auto 60px;
            padding: 0 24px;
            align-items: start;
            box-sizing: border-box;
        }

        .article-main-col {
            min-width: 0;
        }

        .article-header-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 12px;
        }

        .action-pills-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .reader-mode-btn, .like-btn, .blog-report-btn {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--ink);
            font-size: 0.82rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

        .reader-mode-btn:hover, .like-btn:hover, .blog-report-btn:hover {
            border-color: var(--ink);
            background: var(--surface-raised);
            transform: translateY(-1px);
        }

        .like-btn.active {
            background: rgba(225, 29, 72, 0.08);
            border-color: #e11d48;
            color: #e11d48;
        }

        .like-btn.active svg {
            fill: #e11d48;
            stroke: #e11d48;
        }

        .blog-title {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.2rem, 5vw, 3.4rem);
            line-height: 1.2;
            margin: 10px 0 20px;
            color: var(--ink);
            letter-spacing: -0.5px;
        }

        .cover-wrap {
            border-radius: var(--radius);
            overflow: hidden;
            aspect-ratio: 16/9;
            margin: 25px 0 35px;
            box-shadow: var(--card-shadow);
            background: var(--surface-raised);
        }

        .cover-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .blog-content {
            font-size: 1.18rem;
            color: var(--ink);
            line-height: 1.85;
            word-wrap: break-word;
        }

        .blog-content img {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            margin: 24px 0;
            box-shadow: var(--card-shadow);
        }

        .blog-content h2, .blog-content h3, .blog-content h4 {
            font-family: 'DM Serif Display', serif;
            color: var(--ink);
            margin-top: 36px;
            margin-bottom: 16px;
            line-height: 1.3;
        }

        .blog-content blockquote {
            border-left: 4px solid var(--accent);
            padding: 12px 24px;
            margin: 24px 0;
            background: var(--surface-raised);
            border-radius: 0 8px 8px 0;
            font-style: italic;
            color: var(--ink-secondary);
        }

        .blog-content pre {
            background: var(--surface-raised);
            padding: 16px;
            border-radius: 10px;
            overflow-x: auto;
            border: 1px solid var(--border);
        }

        .blog-content code {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9em;
            background: var(--surface-raised);
            padding: 2px 6px;
            border-radius: 4px;
        }

        /* Sidebar & Related Panel */
        .sidebar-col {
            position: sticky;
            top: 90px;
            z-index: 10;
        }

        .related-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px;
            box-shadow: var(--card-shadow);
        }

        .related-title {
            margin: 0 0 16px 0;
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--ink);
            border-bottom: 1px solid var(--border);
            padding-bottom: 12px;
        }

        .related-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .related-item {
            display: flex;
            gap: 12px;
            text-decoration: none;
            color: inherit;
            padding: 8px;
            border-radius: 10px;
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }

        .related-item:hover {
            background: var(--surface-raised);
            border-color: var(--border);
            transform: translateY(-2px);
        }

        .related-img-wrap {
            width: 80px;
            height: 60px;
            border-radius: 8px;
            overflow: hidden;
            flex-shrink: 0;
            background: var(--surface-raised);
        }

        .related-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .related-info {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .related-meta {
            font-size: 0.72rem;
            color: var(--muted);
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .related-item-title {
            margin: 0;
            font-size: 0.88rem;
            font-weight: 600;
            line-height: 1.35;
            color: var(--ink);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Discussion & Comments */
        .discussion-section {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 32px;
            box-shadow: var(--card-shadow);
            margin-bottom: 60px;
        }

        .comment-item {
            display: flex;
            gap: 12px;
            padding: 18px 0;
            border-top: 1px solid var(--border);
            position: relative;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .comment-name { font-weight: 600; font-size: 0.9rem; color: var(--ink); }
        .comment-time { font-size: 0.75rem; color: var(--muted); margin-left: 6px; }

        textarea {
            width: 100%;
            padding: 14px;
            border: 1px solid var(--border);
            border-radius: 12px;
            resize: none;
            background: var(--input-bg);
            font-family: inherit;
            box-sizing: border-box;
            color: var(--ink);
            outline: none;
            transition: border-color 0.2s ease;
        }

        textarea:focus {
            border-color: var(--accent);
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background: var(--accent);
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
            transition: opacity 0.2s ease;
        }

        .btn-submit:hover {
            opacity: 0.9;
        }

        .dots-menu {
            position: absolute;
            right: 0;
            top: 18px;
            cursor: pointer;
            padding: 5px;
            border-radius: 50%;
            color: var(--muted);
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 40px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: var(--card-shadow);
            z-index: 100;
            min-width: 140px;
            overflow: hidden;
        }

        .dropdown-content button {
            display: block;
            padding: 10px 15px;
            color: var(--ink);
            font-size: 0.85rem;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
        }

        .dropdown-content button:hover { background: var(--surface-raised); }
        .dropdown-content .delete-btn { color: #d93025; }
        .show { display: block; }

        .edit-area, .reply-area { display: none; width: 100%; margin-top: 10px; }
        .btn-cancel { background: none; border: none; font-weight: 600; cursor: pointer; color: var(--muted); font-size: 0.85rem; }
        .btn-save, .btn-reply-submit { background: var(--accent); color: white; border: none; padding: 6px 15px; border-radius: 20px; font-weight: 600; cursor: pointer; font-size: 0.85rem; }
        .btn-reply-trigger { background: none; border: none; color: var(--accent); font-size: 0.82rem; font-weight: 600; cursor: pointer; padding: 0; margin-top: 5px; text-decoration: underline; }
        .btn-toggle-replies { background: none; border: none; color: var(--muted); font-size: 0.8rem; font-weight: 600; cursor: pointer; padding: 0; margin-top: 6px; display: inline-flex; align-items: center; gap: 4px; }
        .replies-list { margin-top: 10px; padding-left: 20px; border-left: 2px solid var(--border); }
        .reply-item { display: flex; gap: 10px; padding: 12px 0; font-size: 0.88rem; position: relative; border-top: 1px dashed var(--border); }
        .mention { color: var(--accent); font-weight: 600; background: var(--surface-raised); padding: 1px 4px; border-radius: 4px; }

        /* Emoji picker */
        .textarea-wrap { position: relative; }
        .emoji-btn { position: absolute; bottom: 8px; right: 10px; background: none; border: none; cursor: pointer; padding: 4px; color: var(--muted); }
        .emoji-picker-popup { display: none; position: fixed; width: 300px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--card-shadow); z-index: 9999; overflow: hidden; }
        .emoji-picker-popup.open { display: block; }
        .emoji-tabs { display: flex; gap: 2px; padding: 8px 8px 0; border-bottom: 1px solid var(--border); overflow-x: auto; }
        .emoji-tab { background: none; border: none; cursor: pointer; font-size: 1.1rem; padding: 5px 7px; border-radius: 6px 6px 0 0; }
        .emoji-tab.active { border-bottom: 2px solid var(--ink); background: var(--surface-raised); }
        .emoji-search { padding: 8px 10px; border-bottom: 1px solid var(--border); }
        .emoji-search input { width: 100%; padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; font-size: 0.82rem; background: var(--input-bg); color: var(--ink); outline: none; }
        .emoji-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 2px; padding: 8px; max-height: 200px; overflow-y: auto; }
        .emoji-cell { font-size: 1.3rem; text-align: center; padding: 4px 2px; border-radius: 6px; cursor: pointer; }
        .emoji-cell:hover { background: var(--surface-raised); }

        /* ===================================================
           DISTRACTION-FREE READING MODE (Full Screen Overlay)
           =================================================== */
        .reader-mode-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: #ffffff;
            color: #1a1a1a;
            z-index: 20000;
            overflow-y: auto;
            animation: fadeIn 0.25s ease;
        }

        .reader-mode-overlay.open {
            display: block;
        }

        /* Reader Mode Themes */
        .reader-mode-overlay[data-reader-theme="paper"] {
            background: #fdfcf9;
            color: #1a1a1a;
        }
        .reader-mode-overlay[data-reader-theme="sepia"] {
            background: #f4ecd8;
            color: #433422;
        }
        .reader-mode-overlay[data-reader-theme="dark"] {
            background: #121212;
            color: #d1d5db;
        }

        /* Reader Mode Fonts */
        .reader-mode-overlay[data-reader-font="serif"] .reader-content-body {
            font-family: 'DM Serif Display', 'Playfair Display', Georgia, serif;
        }
        .reader-mode-overlay[data-reader-font="sans"] .reader-content-body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }
        .reader-mode-overlay[data-reader-font="mono"] .reader-content-body {
            font-family: 'JetBrains Mono', monospace;
        }

        .reader-toolbar {
            position: sticky;
            top: 0;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 24px;
            backdrop-filter: blur(12px);
            background: inherit;
            border-bottom: 1px solid rgba(128, 128, 128, 0.2);
        }

        .reader-controls {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .reader-btn {
            background: rgba(128, 128, 128, 0.12);
            border: 1px solid rgba(128, 128, 128, 0.2);
            color: inherit;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .reader-btn:hover {
            background: rgba(128, 128, 128, 0.25);
        }

        .reader-content-wrap {
            max-width: 760px;
            margin: 40px auto 100px;
            padding: 0 24px;
        }

        .reader-title {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.4rem, 5vw, 3.6rem);
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .reader-content-body {
            font-size: 20px;
            line-height: 1.9;
        }

        .reader-content-body img {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            margin: 28px 0;
        }

        /* Report Modal */
        .report-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
        .report-overlay.open { display: flex; }
        .report-modal { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); width: 100%; max-width: 480px; margin: 16px; box-shadow: var(--card-shadow); display: flex; flex-direction: column; max-height: 85vh; overflow: hidden; }
        .report-step { display: none; flex-direction: column; width: 100%; overflow: hidden; }
        .report-step.active { display: flex; flex: 1; }
        .report-modal-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: flex-start; justify-content: space-between; }
        .report-modal-body { padding: 24px; overflow-y: auto; flex: 1; }
        .report-modal-footer { padding: 16px 24px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 12px; background: var(--surface); }
        .report-reason-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
        .report-reason-list li { border: 1px solid var(--border); border-radius: 10px; background: var(--surface); }
        .report-reason-list li label { display: flex; align-items: center; gap: 14px; padding: 12px; cursor: pointer; width: 100%; }
        .report-btn-cancel { background: none; border: 1px solid var(--border); padding: 8px 18px; border-radius: 30px; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--ink-secondary); }
        .report-btn-next, .report-btn-submit { background: var(--accent); color: #fff; border: none; padding: 8px 22px; border-radius: 30px; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
        .report-close-btn { background: none; border: none; cursor: pointer; color: var(--muted); }

        @media (max-width: 900px) {
            .page-grid { grid-template-columns: 1fr; gap: 40px; }
            .sidebar-col { position: static; }
        }
    </style>
</head>

<body>
    <!-- Reading Progress Bar -->
    <div id="reading-progress-container">
        <div id="reading-progress-bar"></div>
    </div>

    <%- include('./partials/nav')%>

    <% function timeAgo(date) {
        const seconds = Math.floor((new Date() - new Date(date)) / 1000);
        let interval = Math.floor(seconds / 31536000);
        if (interval >= 1) return interval + "y ago";
        interval = Math.floor(seconds / 2592000);
        if (interval >= 1) return interval + "mo ago";
        interval = Math.floor(seconds / 604800);
        if (interval >= 1) return interval + "w ago";
        interval = Math.floor(seconds / 86400);
        if (interval >= 1) return interval + "d ago";
        interval = Math.floor(seconds / 3600);
        if (interval >= 1) return interval + "h ago";
        interval = Math.floor(seconds / 60);
        if (interval >= 1) return interval + "m ago";
        return "just now";
    } %>

    <div class="page-grid">
        <article class="article-main-col" id="article-main">
            <!-- Breadcrumbs Navigation -->
            <nav aria-label="Breadcrumb" style="margin-bottom: 16px;">
                <ol style="list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--muted);">
                    <li><a href="/" style="color: inherit; text-decoration: none;">Home</a></li>
                    <li><span style="opacity: 0.5;">/</span></li>
                    <li><a href="/?category=<%= encodeURIComponent(blog.category || 'Editorial') %>" style="color: inherit; text-decoration: none; font-weight: 500;"><%= blog.category || 'Editorial' %></a></li>
                    <li><span style="opacity: 0.5;">/</span></li>
                    <li style="color: var(--ink); font-weight: 600; max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= blog.title %></li>
                </ol>
            </nav>

            <header>
                <div class="article-header-actions">
                    <p style="text-transform: uppercase; font-size: 11.5px; color: var(--muted); font-weight: 600; margin: 0; display: flex; align-items: center; gap: 6px;">
                        <span><%= blog.createdBy?.fullName || 'Editorial' %></span>
                        <span>&bull;</span>
                        <time datetime="<%= new Date(blog.createdAt).toISOString() %>"><%= timeAgo(blog.createdAt) %></time>
                        <span>&bull;</span>
                        <span><%= blog.readTimeMinutes || 3 %> min read</span>
                    </p>

                    <div class="action-pills-group">
                        <button class="reader-mode-btn" onclick="openReaderMode()" title="Distraction-free Reading Mode">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                            Reader Mode
                        </button>
                        <button class="like-btn <%= locals.hasLiked ? 'active' : '' %>" id="like-btn" onclick="toggleLike('<%= blog._id %>')" title="Like this story">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="<%= locals.hasLiked ? '#e11d48' : 'none' %>" stroke="<%= locals.hasLiked ? '#e11d48' : 'currentColor' %>" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="like-svg-icon"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                            <span id="like-counter"><%= blog.likes || 0 %></span>
                        </button>
                        <% if (locals.user) { %>
                            <button class="blog-report-btn" onclick="openReportModal('blog', '<%= blog._id %>')">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                                Report
                            </button>
                        <% } %>
                    </div>
                </div>

                <h1 class="blog-title"><%= blog.title %></h1>
            </header>

            <% if (blog.coverImageURL) { %>
                <div class="cover-wrap">
                    <img 
                        src="<%= (typeof imgOpt === 'function') ? imgOpt(blog.coverImageURL, 'hero') : blog.coverImageURL %>" 
                        alt="<%= blog.title %>" 
                        fetchpriority="high" 
                        loading="eager"
                        width="1200"
                        height="630"
                    >
                </div>
            <% } %>

            <div class="blog-content" id="blog-body-content" style="margin-bottom: 60px;">
                <%- htmlContent %>
            </div>

            <section class="author-footer" style="padding: 36px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 40px;">
                <div style="display: flex; align-items: flex-start; gap: 24px; flex-wrap: wrap;">
                    <a href="/user/<%= blog.createdBy?._id %>">
                        <img class="avatar" style="width: 72px; height: 72px; border: 1px solid var(--border);"
                            src="<%= (typeof imgOpt === 'function' && blog.createdBy?.profileImageURL) ? imgOpt(blog.createdBy.profileImageURL, 'avatar') : (blog.createdBy?.profileImageURL || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(blog.createdBy?.fullName || 'User')) %>"
                            alt="<%= blog.createdBy?.fullName || 'Author' %>"
                            loading="lazy"
                            width="72"
                            height="72"
                        >
                    </a>
                    <div style="flex: 1; min-width: 250px;">
                        <p style="margin: 0 0 4px 0; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); font-weight: 700;">Written by</p>
                        <h3 style="margin: 0 0 8px 0; font-family: 'DM Serif Display', serif; font-size: 1.5rem;">
                            <a href="/user/<%= blog.createdBy?._id %>" style="text-decoration: none; color: var(--ink);"><%= blog.createdBy?.fullName || 'Blogify Editorial' %></a>
                        </h3>
                        <p style="margin: 0; font-size: 0.95rem; color: var(--ink-secondary); max-width: 500px; line-height: 1.5;"><%= blog.createdBy?.bio || 'Curating stories on trends, technology, culture, and perspectives.' %></p>
                    </div>
                </div>
            </section>

            <!-- Comments / Discussion Section -->
            <section class="discussion-section">
                <% const topLevelComments = comments.filter(c => !c.parentComment);
                   const replies = comments.filter(c => c.parentComment); %>

                <h3 style="margin-top: 0; font-family: 'DM Serif Display', serif; font-size: 1.5rem; margin-bottom: 20px;">
                    Discussion (<%= topLevelComments.length %>)
                </h3>

                <% if (locals.user) { %>
                    <form action="/blog/comment/<%= blog._id %>" method="POST" style="margin-bottom: 30px;">
                        <div class="textarea-wrap">
                            <textarea name="content" id="main-comment-input" rows="3" placeholder="Share your thoughts..." required></textarea>
                            <button type="button" class="emoji-btn" onclick="togglePicker('main-picker', 'main-comment-input')"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 13s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></button>
                            <div class="emoji-picker-popup" id="main-picker"></div>
                        </div>
                        <button class="btn-submit" style="margin-top: 10px;">Post Comment</button>
                    </form>
                <% } else { %>
                    <div style="background: var(--surface-raised); border: 1px dashed var(--border); border-radius: 8px; padding: 16px; margin-bottom: 24px; text-align: center;">
                        <p style="margin: 0; font-size: 0.9rem; color: var(--ink-secondary);">
                            <a href="/user/signin" style="color: var(--accent); font-weight: 600; text-decoration: underline;">Sign in</a> to join the discussion.
                        </p>
                    </div>
                <% } %>

                <div class="comment-list" style="margin-top: 20px;">
                    <% if (topLevelComments.length === 0) { %>
                        <p style="color: var(--muted); font-size: 0.92rem; text-align: center; padding: 30px 0;">No comments yet. Be the first to start the conversation!</p>
                    <% } %>

                    <% topLevelComments.slice().reverse().forEach((comment, index) => { %>
                        <% const currentReplies = replies.filter(r => r.parentComment.toString() === comment._id.toString()); %>
                        <div class="comment-item" id="comment-container-<%= comment._id %>">
                            <img class="avatar"
                                src="<%= comment.createdBy.profileImageURL || 'https://ui-avatars.com/api/?name=' + comment.createdBy.fullName %>">

                            <div style="width: 90%; flex-grow: 1;" id="comment-body-wrapper-<%= comment._id %>">
                                <div style="display: flex; align-items: baseline;">
                                    <span class="comment-name"><%= comment.createdBy.fullName %></span>
                                    <span class="comment-time"><%= timeAgo(comment.createdAt) %></span>
                                </div>

                                <p class="comment-body" id="text-<%= comment._id %>" style="margin: 4px 0; font-size: 0.92rem; word-break: break-word; color: var(--ink);">
                                    <%= comment.body %>
                                </p>

                                <div class="edit-area" id="edit-area-<%= comment._id %>">
                                    <div class="textarea-wrap">
                                        <textarea class="edit-textarea" id="input-<%= comment._id %>"><%= comment.body %></textarea>
                                        <button type="button" class="emoji-btn" onclick="togglePicker('picker-edit-<%= comment._id %>', 'input-<%= comment._id %>')"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 13s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></button>
                                        <div class="emoji-picker-popup" id="picker-edit-<%= comment._id %>"></div>
                                    </div>
                                    <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px;">
                                        <button class="btn-cancel" onclick="cancelEdit('<%= comment._id %>')">Cancel</button>
                                        <button class="btn-save" onclick="saveEdit('<%= comment._id %>')">Save</button>
                                    </div>
                                </div>

                                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                                    <% if (locals.user) { %>
                                        <button class="btn-reply-trigger"
                                            onclick="enableReply('<%= comment._id %>', '<%= comment._id %>', '')">Reply</button>
                                    <% } %>

                                    <% if (currentReplies.length > 0) { %>
                                        <button class="btn-toggle-replies open" id="toggle-btn-<%= comment._id %>"
                                            onclick="toggleReplies('<%= comment._id %>', <%= currentReplies.length %>)">
                                            <span id="toggle-label-<%= comment._id %>"><%= currentReplies.length %> <%= currentReplies.length === 1 ? 'reply' : 'replies' %></span>
                                        </button>
                                    <% } %>
                                </div>

                                <div class="reply-area" id="reply-area-<%= comment._id %>">
                                    <div class="textarea-wrap">
                                        <textarea class="reply-textarea" id="reply-input-<%= comment._id %>" rows="2" placeholder="Write a reply..."></textarea>
                                        <button type="button" class="emoji-btn" onclick="togglePicker('picker-reply-<%= comment._id %>', 'reply-input-<%= comment._id %>')"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 13s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></button>
                                        <div class="emoji-picker-popup" id="picker-reply-<%= comment._id %>"></div>
                                    </div>
                                    <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px;">
                                        <button class="btn-cancel" onclick="cancelReply('<%= comment._id %>')">Cancel</button>
                                        <button class="btn-reply-submit" onclick="submitReply('<%= comment._id %>')">Reply</button>
                                    </div>
                                </div>

                                <% if (currentReplies.length > 0) { %>
                                    <div class="replies-list" id="replies-list-<%= comment._id %>">
                                        <% currentReplies.forEach((reply, replyIndex) => { %>
                                            <div class="reply-item" id="comment-container-<%= reply._id %>">
                                                <img class="avatar" style="width:24px; height:24px;"
                                                    src="<%= reply.createdBy.profileImageURL || 'https://ui-avatars.com/api/?name=' + reply.createdBy.fullName %>">
                                                <div style="width: 85%; flex-grow: 1;">
                                                    <div style="display:flex; align-items: baseline;">
                                                        <span class="comment-name" style="font-size:0.8rem;"><%= reply.createdBy.fullName %></span>
                                                        <span class="comment-time" style="font-size:0.7rem;"><%= timeAgo(reply.createdAt) %></span>
                                                    </div>

                                                    <p class="comment-body" id="text-<%= reply._id %>" style="margin:2px 0; color:var(--ink-secondary); font-size:0.88rem; word-break: break-word;">
                                                        <%- reply.body.replace(/^(@\w+)/, '<span class="mention">$1</span>') %>
                                                    </p>

                                                    <% if (locals.user) { %>
                                                        <button class="btn-reply-trigger"
                                                            onclick="enableReply('<%= comment._id %>', '<%= reply._id %>', '@<%= reply.createdBy.fullName.replace(/ /g, '') %> ')">Reply</button>
                                                    <% } %>

                                                    <div class="edit-area" id="edit-area-<%= reply._id %>">
                                                        <div class="textarea-wrap">
                                                            <textarea class="edit-textarea" id="input-<%= reply._id %>"><%= reply.body %></textarea>
                                                            <button type="button" class="emoji-btn" onclick="togglePicker('picker-edit-<%= reply._id %>', 'input-<%= reply._id %>')"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 13s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></button>
                                                            <div class="emoji-picker-popup" id="picker-edit-<%= reply._id %>"></div>
                                                        </div>
                                                        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px;">
                                                            <button class="btn-cancel" onclick="cancelEdit('<%= reply._id %>')">Cancel</button>
                                                            <button class="btn-save" onclick="saveEdit('<%= reply._id %>')">Save</button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="dots-menu" style="top: 12px;" onclick="toggleDropdown('dropdown-reply-<%= index %>-<%= replyIndex %>')">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <circle cx="12" cy="12" r="1" /><circle cx="12" cy="5" r="1" /><circle cx="12" cy="19" r="1" />
                                                    </svg>
                                                </div>

                                                <div id="dropdown-reply-<%= index %>-<%= replyIndex %>" class="dropdown-content" style="top: 32px;">
                                                    <% if (locals.user) { %>
                                                        <% if (locals.user._id.toString() === reply.createdBy._id.toString()) { %>
                                                            <button onclick="enableEdit('<%= reply._id %>')">Edit</button>
                                                            <button class="delete-btn" onclick="deleteComment('<%= reply._id %>')">Delete</button>
                                                        <% } else if (locals.user._id.toString() === blog.createdBy?._id.toString()) { %>
                                                            <button class="delete-btn" onclick="deleteComment('<%= reply._id %>')">Delete (Author)</button>
                                                        <% } else { %>
                                                            <button class="report-btn" onclick="openReportModal('comment', '<%= reply._id %>'); toggleDropdown('dropdown-reply-<%= index %>-<%= replyIndex %>')">Report</button>
                                                        <% } %>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>

                            <div class="dots-menu" onclick="toggleDropdown('dropdown-<%= index %>')">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="1" /><circle cx="12" cy="5" r="1" /><circle cx="12" cy="19" r="1" />
                                </svg>
                            </div>

                            <div id="dropdown-<%= index %>" class="dropdown-content">
                                <% if (locals.user) { %>
                                    <% if (locals.user._id.toString() === comment.createdBy._id.toString()) { %>
                                        <button onclick="enableEdit('<%= comment._id %>')">Edit</button>
                                        <button class="delete-btn" onclick="deleteComment('<%= comment._id %>')">Delete</button>
                                    <% } else if (locals.user._id.toString() === blog.createdBy?._id.toString()) { %>
                                        <button class="delete-btn" onclick="deleteComment('<%= comment._id %>')">Delete (Author)</button>
                                    <% } else { %>
                                        <button class="report-btn" onclick="openReportModal('comment', '<%= comment._id %>'); toggleDropdown('dropdown-<%= index %>')">Report</button>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>
        </article>

        <!-- Sidebar Column: Related Blogs -->
        <aside class="sidebar-col">
            <div class="related-panel">
                <h3 class="related-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    Related Stories
                </h3>

                <div class="related-list">
                    <% if (locals.relatedBlogs && relatedBlogs.length > 0) { %>
                        <% relatedBlogs.forEach(rel => { %>
                            <a href="/blog/<%= rel._id %>" class="related-item">
                                <% if (rel.coverImageURL) { %>
                                    <div class="related-img-wrap">
                                        <img 
                                            src="<%= (typeof imgOpt === 'function') ? imgOpt(rel.coverImageURL, 'thumb') : rel.coverImageURL %>" 
                                            alt="<%= rel.title %>" 
                                            loading="lazy"
                                            width="160"
                                            height="120"
                                        >
                                    </div>
                                <% } %>
                                <div class="related-info">
                                    <span class="related-meta"><%= rel.createdBy?.fullName || 'Editorial' %> &bull; <%= timeAgo(rel.createdAt) %></span>
                                    <h4 class="related-item-title"><%= rel.title %></h4>
                                </div>
                            </a>
                        <% }) %>
                    <% } else { %>
                        <p style="color: var(--muted); font-size: 0.88rem; text-align: center; padding: 25px 0;">No other stories available.</p>
                    <% } %>
                </div>
            </div>
        </aside>
    </div>

    <!-- Distraction-Free Reading Mode Modal Overlay -->
    <div id="readerModeModal" class="reader-mode-overlay" data-reader-theme="paper" data-reader-font="serif">
        <div class="reader-toolbar">
            <div class="reader-controls">
                <button class="reader-btn" onclick="setReaderTheme('paper')">Paper</button>
                <button class="reader-btn" onclick="setReaderTheme('sepia')">Sepia</button>
                <button class="reader-btn" onclick="setReaderTheme('dark')">Dark</button>
                <span style="opacity: 0.3;">|</span>
                <button class="reader-btn" onclick="setReaderFont('serif')">Serif</button>
                <button class="reader-btn" onclick="setReaderFont('sans')">Sans</button>
                <button class="reader-btn" onclick="setReaderFont('mono')">Mono</button>
                <span style="opacity: 0.3;">|</span>
                <button class="reader-btn" onclick="adjustFontSize(-1)">A-</button>
                <button class="reader-btn" onclick="adjustFontSize(1)">A+</button>
            </div>
            <button class="reader-btn" style="background: rgba(220, 38, 38, 0.1); border-color: rgba(220, 38, 38, 0.3);" onclick="closeReaderMode()">
                ✕ Exit Reader Mode
            </button>
        </div>

        <main class="reader-content-wrap">
            <h1 class="reader-title"><%= blog.title %></h1>
            <p style="text-transform: uppercase; font-size: 0.8rem; opacity: 0.7; font-weight: 600; margin-bottom: 30px;">
                By <%= blog.createdBy?.fullName || 'Editorial' %> &bull; <%= blog.readTimeMinutes || 3 %> min read
            </p>
            <div class="reader-content-body" id="reader-body-copy">
                <%- htmlContent %>
            </div>
        </main>
    </div>

    <!-- Report Modal -->
    <div class="report-overlay" id="report-overlay" onclick="handleOverlayClick(event)">
        <div class="report-modal" role="dialog" aria-modal="true">
            <div id="report-step-1" class="report-step active">
                <div class="report-modal-header">
                    <h3 style="margin: 0; font-size: 1.25rem;">Report Content</h3>
                    <button class="report-close-btn" onclick="closeReportModal()">✕</button>
                </div>
                <div class="report-modal-body">
                    <ul class="report-reason-list">
                        <li><label><input type="radio" name="report-reason" value="harassment" onchange="onReasonChange()"> <span>Harassment or bullying</span></label></li>
                        <li><label><input type="radio" name="report-reason" value="misinformation" onchange="onReasonChange()"> <span>Misinformation</span></label></li>
                        <li><label><input type="radio" name="report-reason" value="hate_speech" onchange="onReasonChange()"> <span>Hate speech</span></label></li>
                        <li><label><input type="radio" name="report-reason" value="spam" onchange="onReasonChange()"> <span>Spam or scam</span></label></li>
                        <li><label><input type="radio" name="report-reason" value="other" onchange="onReasonChange()"> <span>Other</span></label></li>
                    </ul>
                </div>
                <div class="report-modal-footer">
                    <button class="report-btn-cancel" onclick="closeReportModal()">Cancel</button>
                    <button class="report-btn-next" id="report-next-btn" disabled onclick="submitReport()">Submit</button>
                </div>
            </div>
        </div>
    </div>

    <%- include('./partials/script')%>

    <!-- Reading Progress, Reader Mode & Like Script -->
    <script>
        // ── Scroll Progress Bar ──────────────────────────────────────────
        window.addEventListener('scroll', () => {
            const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            const bar = document.getElementById('reading-progress-bar');
            if (bar) bar.style.width = scrolled + '%';
        });

        // ── Like / Unlike Interaction with Auth Check ────────────────────
        async function toggleLike(blogId) {
            const btn = document.getElementById('like-btn');
            const counter = document.getElementById('like-counter');
            const icon = document.getElementById('like-svg-icon');
            
            btn.style.transform = 'scale(1.15)';
            setTimeout(() => btn.style.transform = 'none', 150);

            try {
                const res = await fetch(`/blog/${blogId}/like`, { method: 'POST' });
                const data = await res.json();

                if (res.status === 401 || data.requireAuth) {
                    if (confirm("Please sign in to like this story. Would you like to go to the sign-in page now?")) {
                        window.location.href = '/user/signin';
                    }
                    return;
                }

                if (data.success) {
                    counter.textContent = data.likes;
                    if (data.liked) {
                        btn.classList.add('active');
                        if (icon) {
                            icon.setAttribute('fill', '#e11d48');
                            icon.setAttribute('stroke', '#e11d48');
                        }
                    } else {
                        btn.classList.remove('active');
                        if (icon) {
                            icon.setAttribute('fill', 'none');
                            icon.setAttribute('stroke', 'currentColor');
                        }
                    }
                }
            } catch (err) {
                console.error('Like toggle error:', err);
            }
        }

        // ── Reader Mode Controls ────────────────────────────────────────
        let currentReaderFontSize = 20;
        function openReaderMode() {
            document.getElementById('readerModeModal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeReaderMode() {
            document.getElementById('readerModeModal').classList.remove('open');
            document.body.style.overflow = '';
        }

        function setReaderTheme(theme) {
            document.getElementById('readerModeModal').setAttribute('data-reader-theme', theme);
        }

        function setReaderFont(font) {
            document.getElementById('readerModeModal').setAttribute('data-reader-font', font);
        }

        function adjustFontSize(delta) {
            currentReaderFontSize = Math.min(32, Math.max(16, currentReaderFontSize + (delta * 2)));
            document.getElementById('reader-body-copy').style.fontSize = currentReaderFontSize + 'px';
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && document.getElementById('readerModeModal').classList.contains('open')) {
                closeReaderMode();
            }
        });

        // ── Emoji Picker & Report Modal Functions ─────────────────────────
        function toggleDropdown(id) {
            document.querySelectorAll('.dropdown-content').forEach(el => {
                if (el.id !== id) el.classList.remove('show');
            });
            document.getElementById(id).classList.toggle('show');
        }

        window.onclick = function(e) {
            if (!e.target.closest('.dots-menu')) {
                document.querySelectorAll('.dropdown-content').forEach(el => el.classList.remove('show'));
            }
        }

        let reportTarget = { type: null, id: null };
        function openReportModal(type, id) {
            reportTarget = { type, id };
            document.getElementById('report-overlay').classList.add('open');
        }
        function closeReportModal() {
            document.getElementById('report-overlay').classList.remove('open');
        }
        function onReasonChange() {
            document.getElementById('report-next-btn').disabled = false;
        }
        function handleOverlayClick(e) {
            if (e.target === document.getElementById('report-overlay')) closeReportModal();
        }

        async function submitReport() {
            const reason = document.querySelector('input[name="report-reason"]:checked')?.value;
            if (!reason) return;
            try {
                await fetch('/blog/report', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        targetType: reportTarget.type,
                        targetId: reportTarget.id,
                        blogId: '<%= blog._id %>',
                        reason
                    })
                });
                alert('Thank you for reporting. Our moderation team has been notified.');
                closeReportModal();
            } catch (err) {
                console.error(err);
            }
        }

        function enableReply(parentId, targetId, mention) {
            const area = document.getElementById('reply-area-' + parentId);
            const input = document.getElementById('reply-input-' + parentId);
            area.style.display = 'block';
            if (mention) {
                input.value = mention;
                input.focus();
            } else {
                input.value = '';
                input.focus();
            }
        }
        function cancelReply(parentId) {
            document.getElementById('reply-area-' + parentId).style.display = 'none';
        }
        async function submitReply(parentId) {
            const replyContent = document.getElementById('reply-input-' + parentId).value;
            if (!replyContent.trim()) return alert("Reply cannot be empty");
            try {
                const res = await fetch(`/blog/comment/reply/${parentId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content: replyContent })
                });
                if (res.ok) window.location.reload();
            } catch (err) { console.error(err); }
        }
        function enableEdit(id) {
            document.getElementById('text-' + id).style.display = 'none';
            document.getElementById('edit-area-' + id).style.display = 'block';
        }
        function cancelEdit(id) {
            document.getElementById('text-' + id).style.display = 'block';
            document.getElementById('edit-area-' + id).style.display = 'none';
        }
        async function saveEdit(id) {
            const newContent = document.getElementById('input-' + id).value;
            if (!newContent.trim()) return alert("Comment cannot be empty");
            try {
                const res = await fetch(`/blog/comment/edit/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content: newContent })
                });
                if (res.ok) {
                    document.getElementById('text-' + id).innerText = newContent;
                    cancelEdit(id);
                }
            } catch (err) { console.error(err); }
        }
        async function deleteComment(id) {
            if (confirm("Delete this comment?")) {
                const res = await fetch(`/blog/comment/delete/${id}`, { method: 'DELETE' });
                if (res.ok) document.getElementById('comment-container-' + id).remove();
            }
        }
        function toggleReplies(commentId, count) {
            const list = document.getElementById('replies-list-' + commentId);
            const btn = document.getElementById('toggle-btn-' + commentId);
            if (list.style.display === 'none') {
                list.style.display = 'block';
                btn.textContent = count + ' replies';
            } else {
                list.style.display = 'none';
                btn.textContent = 'Show ' + count + ' replies';
            }
        }
    </script>
</body>
</html>