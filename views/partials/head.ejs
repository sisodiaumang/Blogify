<style>
    :root {
        --bg: #fcfaf7;
        --surface: #ffffff;
        --surface-raised: #f7f5f0;
        --ink: #1a1a1a;
        --ink-secondary: #555555;
        --muted: #888888;
        --border: #eceae5;
        --border-hover: #d0cdca;
        --accent: #2d3e50;
        --accent-light: #eef2f6;
        --card-bg: #ffffff;
        --card-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
        --card-hover-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
        --nav-bg: #2d3e50;
        --nav-text: #ffffff;
        --input-bg: #ffffff;
        --tag-bg: #f2efe9;
        --tag-text: #333333;
    }

    [data-theme="dark"] {
        --bg: #0d1117;
        --surface: #161b22;
        --surface-raised: #1f242c;
        --ink: #f0f6fc;
        --ink-secondary: #94a3b8;
        --muted: #64748b;
        --border: #30363d;
        --border-hover: #484f58;
        --accent: #38bdf8;
        --accent-light: rgba(56, 189, 248, 0.12);
        --card-bg: #161b22;
        --card-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        --card-hover-shadow: 0 16px 36px rgba(0, 0, 0, 0.55);
        --nav-bg: #090d13;
        --nav-text: #f0f6fc;
        --input-bg: #1f242c;
        --tag-bg: #21262d;
        --tag-text: #c9d1d9;
    }

    body {
        background-color: var(--bg);
        color: var(--ink);
        transition: background-color 0.25s ease, color 0.25s ease;
    }

    .navbar, nav.navbar {
        width: 100%;
        background-color: var(--nav-bg) !important;
        transition: background-color 0.25s ease;
    }

    .navbar .container, nav.navbar .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* Dark Mode Toggle Pill */
    .theme-toggle-btn {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        border-radius: 30px;
        padding: 6px 12px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

    .theme-toggle-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: translateY(-1px);
    }
</style>