<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head')%>
    <title>Write & Publish Story | Blogify Studio</title>
    <!-- Marked CDN for Live Markdown Parsing -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        .editor-container {
            max-width: 1300px;
            margin: 30px auto 80px;
            padding: 0 20px;
        }

        .editor-header-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .editor-title {
            font-family: 'DM Serif Display', serif;
            font-size: 2.4rem;
            color: var(--ink);
            margin: 0;
        }

        .meta-group {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: var(--card-shadow);
        }

        .title-input {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            border: none;
            border-left: 4px solid var(--accent);
            background: var(--surface-raised);
            padding: 12px 18px;
            margin-bottom: 20px;
            width: 100%;
            outline: none;
            color: var(--ink);
            border-radius: 0 8px 8px 0;
            box-sizing: border-box;
            transition: background 0.2s ease;
        }

        .title-input:focus {
            background: var(--surface);
            border-left-color: var(--ink);
        }

        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
        }

        .meta-label {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted);
            margin-bottom: 8px;
            display: block;
        }

        .select-input, .text-input-field {
            width: 100%;
            background: var(--input-bg);
            border: 1px solid var(--border);
            color: var(--ink);
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.92rem;
            outline: none;
            box-sizing: border-box;
        }

        /* --- Toolbar --- */
        .editor-toolbar {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px 12px 0 0;
            padding: 10px 14px;
            flex-wrap: wrap;
            border-bottom: none;
        }

        .tool-btn {
            background: transparent;
            border: 1px solid transparent;
            color: var(--ink);
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .tool-btn:hover {
            background: var(--surface-raised);
            border-color: var(--border);
        }

        .editor-stats-badge {
            margin-left: auto;
            font-size: 0.8rem;
            color: var(--muted);
            font-weight: 600;
        }

        /* --- Split Pane Architecture --- */
        .split-pane-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border: 1px solid var(--border);
            border-radius: 0 0 12px 12px;
            overflow: hidden;
            box-shadow: var(--card-shadow);
            background: var(--surface);
            min-height: 520px;
        }

        .editor-pane, .preview-pane {
            height: 520px;
            overflow-y: auto;
            box-sizing: border-box;
        }

        .editor-pane {
            border-right: 1px solid var(--border);
            background: var(--surface);
        }

        .editor-textarea {
            width: 100%;
            height: 100%;
            border: none;
            padding: 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.95rem;
            line-height: 1.7;
            background: transparent;
            color: var(--ink);
            resize: none;
            outline: none;
            box-sizing: border-box;
        }

        .preview-pane {
            padding: 24px 30px;
            background: var(--bg);
            color: var(--ink);
            font-family: 'Inter', sans-serif;
            line-height: 1.8;
            font-size: 1.05rem;
        }

        .preview-pane h1, .preview-pane h2, .preview-pane h3 {
            font-family: 'DM Serif Display', serif;
            color: var(--ink);
        }

        .preview-pane img {
            max-width: 100%;
            border-radius: 8px;
            margin: 16px 0;
        }

        .preview-pane blockquote {
            border-left: 4px solid var(--accent);
            padding-left: 16px;
            color: var(--ink-secondary);
            font-style: italic;
        }

        /* --- Drag & Drop Multi-Image Dropzone --- */
        .dropzone-box {
            border: 2px dashed var(--border);
            border-radius: var(--radius);
            padding: 24px;
            text-align: center;
            background: var(--surface-raised);
            cursor: pointer;
            transition: all 0.2s ease;
            margin-bottom: 24px;
        }

        .dropzone-box:hover, .dropzone-box.dragover {
            border-color: var(--accent);
            background: var(--accent-light);
        }

        .uploaded-thumbnails-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }

        .uploaded-thumb-card {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: var(--surface);
        }

        .uploaded-thumb-card img {
            width: 100%;
            height: 90px;
            object-fit: cover;
        }

        .btn-insert-img {
            width: 100%;
            background: var(--surface-raised);
            border: none;
            border-top: 1px solid var(--border);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 4px;
            color: var(--ink);
            cursor: pointer;
        }

        .btn-insert-img:hover {
            background: var(--ink);
            color: var(--surface);
        }

        .btn-publish-main {
            background: var(--accent);
            color: #ffffff;
            border: none;
            padding: 12px 36px;
            font-size: 1rem;
            font-weight: 700;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(0,0,0,0.15);
            transition: all 0.2s ease;
        }

        .btn-publish-main:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        @media (max-width: 860px) {
            .split-pane-wrapper { grid-template-columns: 1fr; }
            .editor-pane { border-right: none; border-bottom: 1px solid var(--border); height: 360px; }
            .preview-pane { height: 360px; }
        }
    </style>
</head>

<body>
    <%- include('./partials/nav')%>

    <main class="editor-container">
        <form action="/blog" method="POST" enctype="multipart/form-data" id="postForm">
            <div class="editor-header-bar">
                <div>
                    <h1 class="editor-title">Create Story</h1>
                    <p style="color: var(--muted); margin: 4px 0 0; font-size: 0.9rem;">Craft and format rich articles with multi-image support & instant markdown preview.</p>
                </div>
                <div>
                    <button type="submit" class="btn-publish-main">Publish Story</button>
                </div>
            </div>

            <!-- Meta Settings Card -->
            <div class="meta-group">
                <input 
                    type="text" 
                    name="title" 
                    id="postTitle"
                    class="title-input" 
                    placeholder="Enter engaging story headline..." 
                    required
                >

                <div class="meta-grid">
                    <div>
                        <label class="meta-label">Category</label>
                        <select name="category" class="select-input" required>
                            <option value="Editorial">Editorial & Essay</option>
                            <option value="Google Trends">Google Trends</option>
                            <option value="Technology">Tech & Artificial Intelligence</option>
                            <option value="Geopolitics">World & Geopolitics</option>
                            <option value="Economy">Economy & Markets</option>
                            <option value="Breaking News">Breaking News</option>
                        </select>
                    </div>

                    <div>
                        <label class="meta-label">Primary Hero Cover Image</label>
                        <input type="file" name="coverImage" id="coverImage" class="select-input" accept="image/*">
                    </div>

                    <div>
                        <label class="meta-label">Tags (comma-separated)</label>
                        <input type="text" name="tags" class="text-input-field" placeholder="e.g. AI, Tech, Innovation, Google">
                    </div>
                </div>
            </div>

            <!-- Multi-Image Drag-and-Drop & Gallery Uploader -->
            <div class="meta-group">
                <label class="meta-label">Multi-Image Gallery & Drag-and-Drop Uploader</label>
                <div class="dropzone-box" id="dropzoneBox" onclick="document.getElementById('galleryInput').click()">
                    <div style="margin-bottom: 8px; color: var(--accent);">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </div>
                    <div style="font-weight: 600; color: var(--ink); margin-bottom: 4px;">Click to select or drag & drop multiple images</div>
                    <div style="font-size: 0.82rem; color: var(--muted);">Upload multiple contextual illustrations for instant markdown embedding</div>
                    <input type="file" id="galleryInput" name="galleryImages" multiple accept="image/*" style="display: none;" onchange="handleGalleryFiles(this.files)">
                </div>

                <div class="uploaded-thumbnails-grid" id="thumbnailsGrid"></div>
            </div>

            <!-- Formatting Toolbar & Split Pane Editor -->
            <div class="editor-toolbar">
                <button type="button" class="tool-btn" onclick="insertFormat('**', '**')"><b>B</b></button>
                <button type="button" class="tool-btn" onclick="insertFormat('*', '*')"><i>I</i></button>
                <button type="button" class="tool-btn" onclick="insertFormat('## ', '')">H2</button>
                <button type="button" class="tool-btn" onclick="insertFormat('### ', '')">H3</button>
                <button type="button" class="tool-btn" onclick="insertFormat('> ', '')">Quote</button>
                <button type="button" class="tool-btn" onclick="insertFormat('```\n', '\n```')">Code</button>
                <button type="button" class="tool-btn" onclick="insertFormat('- ', '')">List</button>
                <button type="button" class="tool-btn" onclick="insertFormat('| Header | Column |\n| --- | --- |\n| Data | Value |', '')">Table</button>
                <button type="button" class="tool-btn" onclick="insertFormat('[Link Title](', ')')">Link</button>

                <div class="editor-stats-badge" id="statsBadge">0 words &bull; ~1 min read</div>
            </div>

            <div class="split-pane-wrapper">
                <div class="editor-pane">
                    <textarea 
                        name="body" 
                        id="markdownEditor" 
                        class="editor-textarea" 
                        placeholder="Write your story in Markdown... Type or paste images directly!"
                        oninput="updatePreview()"
                    ></textarea>
                </div>
                <div class="preview-pane" id="markdownPreview">
                    <p style="color: var(--muted); font-style: italic;">Live preview will appear here as you write...</p>
                </div>
            </div>
        </form>
    </main>

    <%- include('./partials/script')%>

    <script>
        const editor = document.getElementById('markdownEditor');
        const preview = document.getElementById('markdownPreview');
        const statsBadge = document.getElementById('statsBadge');

        function updatePreview() {
            const raw = editor.value;
            if (!raw.trim()) {
                preview.innerHTML = '<p style="color: var(--muted); font-style: italic;">Live preview will appear here as you write...</p>';
                statsBadge.textContent = '0 words • ~1 min read';
                return;
            }

            preview.innerHTML = marked.parse(raw);
            const wordCount = raw.trim().split(/\s+/).filter(Boolean).length;
            const readTime = Math.max(1, Math.ceil(wordCount / 200));
            statsBadge.textContent = `${wordCount} words • ~${readTime} min read`;
        }

        function insertFormat(prefix, suffix) {
            const start = editor.selectionStart;
            const end = editor.selectionEnd;
            const selectedText = editor.value.substring(start, end);
            const replacement = prefix + selectedText + suffix;
            editor.value = editor.value.substring(0, start) + replacement + editor.value.substring(end);
            editor.focus();
            editor.selectionStart = start + prefix.length;
            editor.selectionEnd = start + prefix.length + selectedText.length;
            updatePreview();
        }

        // Drag & Drop Multiple Image Upload Zone
        const dropzone = document.getElementById('dropzoneBox');
        ['dragenter', 'dragover'].forEach(name => {
            dropzone.addEventListener(name, (e) => { e.preventDefault(); dropzone.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(name => {
            dropzone.addEventListener(name, (e) => { e.preventDefault(); dropzone.classList.remove('dragover'); });
        });
        dropzone.addEventListener('drop', (e) => {
            const files = e.dataTransfer.files;
            if (files && files.length > 0) handleGalleryFiles(files);
        });

        async function handleGalleryFiles(files) {
            const grid = document.getElementById('thumbnailsGrid');
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                if (!file.type.startsWith('image/')) continue;

                const formData = new FormData();
                formData.append('image', file);

                try {
                    const res = await fetch('/blog/upload-image', {
                        method: 'POST',
                        body: formData
                    });
                    const data = await res.json();
                    if (data.success && data.imageUrl) {
                        const card = document.createElement('div');
                        card.className = 'uploaded-thumb-card';
                        card.innerHTML = `
                            <img src="${data.imageUrl}" alt="Uploaded image">
                            <button type="button" class="btn-insert-img" onclick="insertImageToDoc('${data.imageUrl}')">+ Insert</button>
                        `;
                        grid.appendChild(card);
                    }
                } catch (err) {
                    console.error('Image upload failed:', err);
                }
            }
        }

        function insertImageToDoc(url) {
            insertFormat(`\n\n![Illustration](${url})\n*Caption: In-depth visual context.*\n\n`, '');
        }
    </script>
</body>
</html>